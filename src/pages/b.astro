---
/**
 * `/b` — variant B (04-ui-spec §Routy, ADR-0003). Hero „serif statement" + O mne + pätička.
 * IDENTICKÝ obsah aj farby ako `/`; líši sa IBA typografickým variantom hero. `noindex` dedí z Base.
 * Zdieľa About/Footer/texty s `/` — jeden zdroj (copy.ts), aby sa varianty nerozišli v obsahu.
 */
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Footer from "../components/Footer.astro";
---

<Base title="Tomáš Tornyos — architekt">
  <main class="page-main">
    <Hero variant="b" />
    <About />
  </main>

  <Footer />
</Base>

<style>
  .page-main {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 8vh, 4rem);
  }
</style>
