---
/**
 * `/` — jediná routa (04-ui-spec §Routy). Hero „claim-forward" + O mne + pätička.
 * Variant A je definitíva (2026-07-14); route-based A/B z ADR-0003 je rozpustené. `noindex` dedí z Base.
 */
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Footer from "../components/Footer.astro";
---

<Base title="Tomáš Tornyos — architekt">
  <main class="page-main">
    <Hero />
    <About />
  </main>

  <Footer />
</Base>

<style>
  .page-main {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 8vh, 4rem);
  }
</style>
