---
/**
 * Pätička — DRAFT (02-contracts §5/§7, 04-ui-spec §Pätička).
 * §15 označenie zo S0 + S1 rozšírenie: GDPR odkaz, náklady kampane (placeholder),
 * veta o architektonickej práci (kap. 3). Nové položky viditeľne `[DRAFT — S7]`;
 * presné znenie a údaje potvrdzuje S7 (úloha 12.5/12.7). Žiadny formulár/zber v S1.
 * Trvalý prvok — bude na každej stránke aj po launchi.
 */
import { FOOTER } from "../content/copy";
---

<footer class="site-footer">
  <hr class="rule" />
  <p class="disclosure">
    <strong>Objednávateľ:</strong> Ing. arch. Tomáš Tornyos, [obec trvalého pobytu]
    <span class="draft">[DRAFT — S7]</span>
  </p>
  <p class="disclosure">
    <strong>Dodávateľ:</strong> [meno/názov dodávateľa]
    <span class="draft">[DRAFT — S7]</span>
  </p>
  <p class="disclosure note">
    Označenie podľa § 15 zák. č. 181/2014 Z. z. — návrh, čaká na právnu kontrolu.
  </p>

  <p class="disclosure">
    <a class="footer-link" href={FOOTER.gdprHref}>{FOOTER.gdprLabel}</a>
    <span class="draft">[DRAFT — S7]</span>
  </p>
  <p class="disclosure">
    {FOOTER.costs}
    <span class="draft">[DRAFT — S7]</span>
  </p>
  <p class="disclosure architect">
    {FOOTER.architect.lead}<a
      class="footer-link"
      href={FOOTER.architect.href}
      target="_blank"
      rel="noopener noreferrer">{FOOTER.architect.text}</a>{FOOTER.architect.suffix}
  </p>
</footer>

<style>
  .site-footer {
    margin-block-start: auto;
    font-size: 0.8125rem; /* ~13 px, malé písmo */
    color: var(--muted);
  }

  .disclosure {
    margin-block-start: 0.5rem;
  }

  .disclosure strong {
    color: var(--text);
    font-weight: 600;
  }

  /* Akcent len ako podčiarknutie (plocha), nie ako farba textu — kontrakt §2. */
  .draft {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--ink);
    border-block-end: 2px solid var(--accent);
    white-space: nowrap;
  }

  .note {
    margin-block-start: 0.75rem;
  }

  .architect {
    margin-block-start: 0.75rem;
  }

  /* Odkaz: atramentový text, okrové podčiarknutie (nie farba textu) — ako v S0. */
  .footer-link {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.15em;
  }

  .rule {
    margin-block-end: 1.25rem;
  }
</style>
